{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "npx -y pnpm --filter @workspace/agrishield run dev",
    "build": "npx -y pnpm --filter @workspace/agrishield run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "npx -y pnpm --filter @workspace/agrishield run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
